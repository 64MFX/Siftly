generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bookmark {
  id            String    @id @default(cuid())
  tweetId       String    @unique
  text          String
  authorHandle  String
  authorName    String
  tweetCreatedAt DateTime?
  importedAt    DateTime  @default(now())
  rawJson       String    // full JSON stored as string
  semanticTags    String?   // JSON array of AI-generated searchable tags
  entities        String?   // JSON: {hashtags[], urls[], mentions[], tools[], tweetType}
  enrichedAt      DateTime? // when AI enrichment last ran — drives incremental processing
  enrichmentMeta  String?   // JSON: {sentiment, people[], companies[]} from batch enrichment
  source          String    @default("bookmark")  // "bookmark" | "like"
  archivedAt      DateTime? // when the tweet/article/media was last saved to the local archive
  archiveStatus   String?   // "complete" | "partial" | "failed" — null means never archived
  archiveError    String?   // warnings from the last archive run (missing media, unreachable X, …)
  linkCard        String?   // JSON LinkCard: title/description/site/image of the page the post links to
  readLaterAt     DateTime? // when it was put on the Read Later list — null means not on it
  readLaterFolderId String? // Read Later folder it's filed in (only while on the list) — null means Unsorted
  readLaterFolder ReadLaterFolder? @relation(fields: [readLaterFolderId], references: [id], onDelete: SetNull)
  mediaItems    MediaItem[]
  categories    BookmarkCategory[]

  @@index([authorHandle])
  @@index([tweetCreatedAt])
  @@index([enrichedAt])
  @@index([source])
  @@index([archiveStatus])
  @@index([readLaterAt])
  @@index([readLaterFolderId])
}

/// The user's own folders for the Read Later list — separate from categories and the AI
model ReadLaterFolder {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  bookmarks Bookmark[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1")
  description String?
  isAiGenerated Boolean @default(false)
  userEdited  Boolean  @default(false) // name/description/color changed by the user — default seeding leaves it alone
  createdAt   DateTime @default(now())
  bookmarks   BookmarkCategory[]
}

model BookmarkCategory {
  bookmarkId  String
  categoryId  String
  confidence  Float    @default(1.0)
  bookmark    Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, categoryId])
}

model MediaItem {
  id           String   @id @default(cuid())
  bookmarkId   String
  type         String   // photo | video | gif
  url          String
  thumbnailUrl String?
  localPath    String?  // archived copy, relative to the archive root (e.g. "<tweetId>/media/01.jpg")
  localThumbnailPath String? // archived poster frame for videos / GIFs
  imageTags    String?  // AI-generated structured JSON visual description
  bookmark     Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@index([bookmarkId])
  @@index([url])
}

model ImportJob {
  id             String   @id @default(cuid())
  filename       String
  status         String   @default("pending") // pending | processing | done | error
  totalCount     Int      @default(0)
  processedCount Int      @default(0)
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}
